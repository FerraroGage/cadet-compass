    "id": "usmc.drill.purpose",
    "branch": [
      "usmc"
    ],
    "module": "drill",
    "topic": "Purpose of drill",
    "text": "Commanders use drill to move units in a standard, orderly manner; provide simple formations from which combat formations may be readily assumed; teach discipline by instilling habits of precision and automatic response to orders; increase the confidence of junior leaders through exercise of command; and give troops an opportunity to handle individual weapons.",
    "q": "Drill teaches discipline by instilling what habits?",
    "a": "Precision and automatic response to orders",
