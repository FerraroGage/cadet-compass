# Copy this file to .env and fill in the two values from your Supabase project
# (Project Settings > API). With no .env the app runs guest-only: no accounts, nothing leaves the device.
#
# Both values are meant to be public. The anon key only lets a signed-in cadet reach their own rows,
# which supabase/schema.sql enforces. NEVER put the service_role key here or anywhere in this repo.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
